fs = import('fs')

# gnulib: custom rules for meson.
# gnulib normally generates autoconf/automake code via gnulib-tool.
# Here we handle it directly: gnulib generates source files and .in.h
# header templates under libgnu/. The .in.h templates are normally
# processed by autoconf; we handle .h generation ourselves via
# configure_file, and compile the .c sources into a static library.
#
# Prerequisite: gnulib modules must have been imported (via
# gnulib-tool --import, typically run by ./bootstrap).  If you are
# building from a distribution tarball the processed files are already
# present.

# Gnulib source files expected to be generated by gnulib-tool.
# This list comes from what the imported modules produce:
#   bootstrap bcp47 configmake flock getopt-posix gnu-make
#   manywarnings relocatable-lib-lgpl
gnulib_src_candidates = [
  'alloca.c',
  'bcp47.c',
  'c-ctype.c',
  'flock.c',
  'getopt.c',
  'getopt1.c',
  'malloc.c',
  'memeq.c',
  'rawmemchr.c',
  'relocatable.c',
  'strchrnul.c',
  'strdup.c',
  'unistd.c',
  'stdlib.c',
  'streq.c',
  'dummy.c',
]

# Windows-only sources
if host_machine.system() == 'windows'
  gnulib_src_candidates += ['msvc-inval.c', 'msvc-nothrow.c']
endif

gnulib_sources = []
foreach src : gnulib_src_candidates
  if fs.exists(meson.current_source_dir() / src)
    gnulib_sources += files(src)
  endif
endforeach

if gnulib_sources.length() == 0
  # Try gnulib-tool from the submodule or system
  gnulib_submodule_dir = meson.project_source_root() / 'gnulib'
  gnulib_tool = find_program(
    gnulib_submodule_dir / 'gnulib-tool',
    'gnulib-tool',
    required: false,
  )
  if gnulib_tool.found()
    message('Importing gnulib modules...')
    # gnulib-tool must run from the source root (where configure.ac lives).
    # Use sh -c to cd there first before invoking gnulib-tool.
    run_command(
      find_program('sh'),
      '-c',
      'cd "$1" && shift && "$@"',
      'dummy',
      meson.project_source_root(),
      gnulib_tool,
      '--import',
      '--lgpl=2',
      '--makefile-name=Makefile.gnulib',
      '--source-base=libgnu',
      '--m4-base=m4',
      '--local-dir=gl-mod/bootstrap',
      '--local-dir=gl',
      'bootstrap', 'bcp47', 'configmake', 'flock',
      'getopt-posix', 'gnu-make', 'manywarnings',
      'relocatable-lib-lgpl',
      check: true,
    )
    foreach src : gnulib_src_candidates
      if fs.exists(meson.current_source_dir() / src)
        gnulib_sources += files(src)
      endif
    endforeach
  endif
endif

if gnulib_sources.length() == 0
  error(
    'gnulib sources not found in libgnu/ and gnulib-tool is not available.\n' +
    'Please run: git submodule update --init && ./bootstrap\n' +
    'or ensure the gnulib submodule is checked out and gnulib-tool is in PATH.'
  )
endif

# After gnulib-tool, some headers are delivered as .in.h templates.
# Process them into .h via configure_file so they are usable by the
# compiler.  The substitution variables come from meson's own config.h
# generation (see root meson.build).
in_h_files = run_command(
  'sh', '-c',
  'cd "$0" && ls *.in.h 2>/dev/null || true',
  meson.current_source_dir(),
  check: false,
).stdout().strip().split('\n')
foreach ih : in_h_files
  if ih != ''
    h_name = ih.replace('.in.h', '').replace('.in', '')
    if not fs.exists(meson.current_source_dir() / h_name)
      configure_file(
        input: ih,
        output: h_name,
        configuration: conf,
      )
    endif
  endif
endforeach

# Generate configmake.h - normally produced by gnulib's configmake module
# via sed in Makefile.gnulib. We produce it directly here.
pkgdatadir = get_option('prefix') / get_option('datadir') / 'enchant-@0@'.format(major_version)
pkglibdir = get_option('prefix') / get_option('libdir') / 'enchant-@0@'.format(major_version)
sysconfdir = get_option('sysconfdir')

configmake_conf = configuration_data()
configmake_conf.set_quoted('PKGDATADIR', pkgdatadir)
configmake_conf.set_quoted('PKGLIBDIR', pkglibdir)
configmake_conf.set_quoted('SYSCONFDIR', sysconfdir)
configmake_conf.set_quoted('INSTALLPREFIX', get_option('prefix'))

configmake_h = configure_file(
  output: 'configmake.h',
  configuration: configmake_conf,
)

# Flags needed by relocatable-lib-lgpl module
gnulib_c_args = [
  '-DIN_LIBRARY',
  '-DENABLE_COSTLY_RELOCATABLE',
]
if shlibs_in_bindir
  gnulib_c_args += ['-DINSTALLDIR=BINDIR', '-include', 'configmake.h']
else
  gnulib_c_args += ['-DINSTALLDIR=LIBDIR', '-include', 'configmake.h']
endif

gnulib_inc = include_directories('.')

libgnu = static_library(
  'gnu',
  gnulib_sources,
  c_args: gnulib_c_args,
  include_directories: gnulib_inc,
  install: false,
  pic: true,
)

gnulib_dep = declare_dependency(
  link_with: libgnu,
  include_directories: gnulib_inc,
)
